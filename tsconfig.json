{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@your-org/auth-rn": [
        "./lib/better-auth-rn/packages/auth-rn/src"
      ],
      "@your-org/auth-rn/*": [
        "./lib/better-auth-rn/packages/auth-rn/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "lib/better-auth-rn/demo-app"
  ]
}